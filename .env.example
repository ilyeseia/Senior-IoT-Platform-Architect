# --- backend ---
PORT=3000
NODE_ENV=development

# CloudAMQP (decision #1 — no self-hosted broker; this is your existing device broker)
MQTT_URL=mqtts://user:pass@your-instance.rmq.cloudamqp.com:8883
MQTT_BASE_TOPIC_PREFIX=espclaw

# Postgres + TimescaleDB (Phase 5). Matches docker-compose.yml's dev credentials
# — `docker compose up -d postgres` gets you a working local instance.
DATABASE_URL=postgres://esp_claw:esp_claw_dev_only@localhost:5432/esp_claw_platform

# Redis (Phase 8 — command correlation moves here once horizontal scaling needs
# it; Phase 4 uses a simple in-memory correlation map, which is correct for a
# single backend instance)
REDIS_URL=redis://localhost:6379

# Auth (Identity module, Architecture Evolution §10/§12/§22). REQUIRED — the
# app refuses to boot without it (min 16 chars). Generate a real random value
# per environment, e.g.: openssl rand -base64 32
JWT_SECRET=change-me-in-every-environment-min-16-chars

# Data Plane telemetry (Architecture Evolution §13, Option B). Optional — defaults to 60000ms.
# How often the platform polls each online device's already-real mqtt_status/vpn_status/
# network_status/ota_status capabilities and stores their scalar fields as telemetry.
TELEMETRY_POLL_INTERVAL_MS=60000

# --- Stage 0 hardening (docs/architecture/STAGE0-STABILIZATION.md) ---
# Extra hostnames LocalApiClient may contact, comma-separated (SSRF guard). Private/Tailscale
# IPv4 literals (10/8, 172.16/12, 192.168/16, 100.64/10) are always allowed; other DNS names are not.
# LOCAL_API_ALLOWED_HOSTS=my-device.tailXXXX.ts.net

# --- Identity hardening (docs/architecture/IDENTITY-AUTH.md) ---
# Secret required by POST /auth/register to create the FIRST admin (send it as "bootstrapToken").
# Optional in development, REQUIRED when NODE_ENV=production (min 16 chars). Without it, whoever
# reaches a fresh deployment first becomes admin. Generate:  openssl rand -base64 32
# ADMIN_BOOTSTRAP_TOKEN=

# --- Observability (docs/architecture/STAGE1-EVENTS-AND-BOUNDARIES.md) ---
# "json" = one JSON object per log line with correlation_id (default when NODE_ENV=production);
# "text" = Nest's readable logs (default otherwise).
# LOG_FORMAT=json
