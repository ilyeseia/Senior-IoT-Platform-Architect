# --- backend ---
PORT=3000
NODE_ENV=development

# CloudAMQP (decision #1 — no self-hosted broker; this is your existing device broker)
MQTT_URL=mqtts://user:pass@your-instance.rmq.cloudamqp.com:8883
MQTT_BASE_TOPIC_PREFIX=espclaw

# Postgres + TimescaleDB (Phase 5)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/esp_claw_platform

# Redis (Phase 4/8 — command correlation, WS fan-out)
REDIS_URL=redis://localhost:6379

# Auth (Phase 10 hardens this; JWT_SECRET must be a real random value in any real deployment)
JWT_SECRET=change-me-in-every-environment
